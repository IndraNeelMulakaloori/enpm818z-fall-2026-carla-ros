Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: RGB Camera
      Topic:
        Value: ""          # TODO Task 4: /carla/camera/rgb/image
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Depth Camera
      Topic:
        Value: ""          # TODO Task 4: /carla/camera/depth/image
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Enabled: true
      Name: LiDAR
      Size (Pixels): 2
      Style: Points
      Topic:
        Value: ""          # TODO Task 4: /carla/lidar/points
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Channel Name: velocity
      Enabled: true
      Name: RADAR
      Size (m): 0.3
      Style: Spheres
      Topic:
        Value: ""          # TODO Task 4: /carla/radar/tracks
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: ego_vehicle
    Frame Rate: 30
  Value: true
Window Geometry:
  Height: 900
  Width: 1600
