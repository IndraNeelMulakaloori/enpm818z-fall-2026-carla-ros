<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ads_pipeline</name>
  <version>0.1.0</version>
  <description>
    ENPM818Z cumulative ADS pipeline. GP1 establishes the sensor suite and
    data pipeline; GP2 to GP4 extend this same package.
  </description>

  <!-- TODO: replace with your team details before submitting. -->
  <maintainer email="team@umd.edu">GP1 Team X</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>

  <!-- The CARLA-to-ROS conversions live in the L2 demo package. GP1 imports
       them rather than reimplementing them; see README. -->
  <exec_depend>l2_carla_demo</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
